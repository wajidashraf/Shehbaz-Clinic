# Copy this file to .env.local and replace blank values locally.
# Never commit or share the completed .env.local file.
APP_URL=http://localhost:3000
# Production on Netlify: set APP_URL=https://shahbazdental.com in the Netlify
# UI, CLI, or API with both Builds and Functions/Runtime scopes.

MONGODB_URI=
MONGODB_DATABASE=shahbaz_clinic_dev

SESSION_SECRET=

# Used only by `npm run seed`; rotate before production.
ADMIN_EMAIL=
ADMIN_SECONDARY_EMAIL=
ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shahbaz-dental-clinic/development

REDIS_URL=

EMAIL_PROVIDER=development
BREVO_API_KEY=
EMAIL_FROM_NAME="Shahbaz Dental Clinic"
EMAIL_FROM_ADDRESS=

SMS_PROVIDER=development
BREVO_SMS_SENDER=
